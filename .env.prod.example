# Production secrets — copy to .env.prod and fill real values.
# Never commit .env.prod.
# MySQL: usa la base de Coolify (no hay servicio mysql en este compose).

NODE_ENV=production

# --- Opción A: subpath (ahora) — convive con la web Level Cross ---
# Coolify: PathPrefix /auth + StripPrefix /auth
APP_URL=https://levelcross.iglesiasalem.com/auth
BASE_PATH=/auth
COOKIE_DOMAIN=levelcross.iglesiasalem.com
# Más adelante, para SSO en *.iglesiasalem.com:
# COOKIE_DOMAIN=.iglesiasalem.com

# --- Opción B: subdominio dedicado (futuro) ---
# APP_URL=https://auth.iglesiasalem.com
# BASE_PATH=
# COOKIE_DOMAIN=.iglesiasalem.com

AUTH_HOST_PORT=3100
COOKIE_SECURE=true

# MySQL Coolify (estilo Laravel)
DB_CONNECTION=mysql
DB_HOST=coolify-mysql
DB_PORT=3306
DB_DATABASE=authlevel
DB_USERNAME=user
DB_PASSWORD=password
# Opcional: DATABASE_URL=mysql://user:password@host:3306/authlevel

JWT_SECRET=change-me-jwt-at-least-32-characters-long
SESSION_SECRET=change-me-session-at-least-32-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud → URI de redirección autorizada:
#   {APP_URL}/oauth/google/callback
# Ej. ahora: https://levelcross.iglesiasalem.com/auth/oauth/google/callback

SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_OPEN_SETUP=false

# Migraciones en Coolify: el entrypoint corre `prisma migrate deploy` al arrancar.
# SKIP_DB_MIGRATE=true
# DB_MIGRATE_RETRIES=10
# DB_MIGRATE_RETRY_MS=3000
