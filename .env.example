# Application — local con Traefik
# Auth en http://localhost (Google OAuth no acepta *.localhost)
NODE_ENV=development
PORT=3100
APP_URL=http://localhost
BASE_PATH=
WEB_DEV_URL=http://localhost
CORS_ORIGINS=http://leveladmin.localhost,http://levelweb.localhost,http://localhost
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MySQL (estilo Laravel). Prisma recibe DATABASE_URL compuesto en runtime.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=authlevel
DB_USERNAME=authlevel
DB_PASSWORD=authlevel

# Secrets (change in production)
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
SESSION_SECRET=dev-session-secret-change-me-please

# Google OAuth — redirect en Google Cloud Console:
#   http://localhost/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token TTLs
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Optional: allow bootstrap without token in local only
ALLOW_OPEN_SETUP=true
