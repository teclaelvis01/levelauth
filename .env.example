# Application — local con Traefik
# Auth en http://localhost (Google OAuth no acepta *.localhost)
NODE_ENV=development
PORT=3100
APP_URL=http://localhost
BASE_PATH=
WEB_DEV_URL=http://localhost
# Clientes OAuth: leveladmin (erp), levelweb (campistas/líderes), etc.
CORS_ORIGINS=http://leveladmin.localhost,http://levelweb.localhost,http://localhost
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MySQL (estilo Laravel). Prisma recibe DATABASE_URL compuesto en runtime.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=authlevel
DB_USERNAME=authlevel
DB_PASSWORD=authlevel

# Secrets (change in production)
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
SESSION_SECRET=dev-session-secret-change-me-please

# Google OAuth — redirect en Google Cloud Console:
#   http://localhost/oauth/google/callback
# Apps SSO: erp | games | setlists | levelweb
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token TTLs (fijos en código: server/src/lib/token-ttl.ts — no van en .env)

# Optional: allow bootstrap without token in local only
ALLOW_OPEN_SETUP=true

# Dev: login solo con email (sin Google). En local conviene true
# para ver la pantalla Authorize con botón Google (no auto-redirect).
# ALLOW_DEV_LOGIN=true

# Storage: local (solo volumen) | r2 (S3/R2 + fallback local).
# Avatares en R2: {R2_KEY_PREFIX}auth/avatars/* (mismo bucket/prefijo que leveladmin-api).
# UPLOADS_DIR=          # default: {cwd}/uploads (dev docker: /app/server/uploads)
STORAGE_DRIVER=local
# STORAGE_FALLBACK_LOCAL=true
# R2_KEY_PREFIX=levelcross/level-dev/
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=   # opcional; vacío → https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
