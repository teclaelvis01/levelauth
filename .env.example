# Application
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100
# Prefijo público. Vacío en local. En Coolify bajo la web Level Cross: /auth
BASE_PATH=
# En `pnpm dev` / docker-compose.dev.yml la SPA con HMR vive en Vite.
# El API redirige rutas HTML a esta URL (OAuth callback sigue en APP_URL).
WEB_DEV_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MySQL (estilo Laravel). Prisma recibe DATABASE_URL compuesto en runtime.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=authlevel
DB_USERNAME=authlevel
DB_PASSWORD=authlevel
# Opcional: si defines DATABASE_URL, tiene prioridad sobre DB_*.

# Secrets (change in production)
JWT_SECRET=dev-jwt-secret-change-me-please-32chars
SESSION_SECRET=dev-session-secret-change-me-please

# Google OAuth (obligatorio para login — se configura solo por entorno, no en la web)
# En Google Cloud Console autoriza el redirect:
#   {APP_URL}/oauth/google/callback
# Local: http://localhost:3100/oauth/google/callback
# Prod subpath: https://levelcross.iglesiasalem.com/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token TTLs
SESSION_TTL_HOURS=168
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Optional: allow bootstrap without token in local only
ALLOW_OPEN_SETUP=true
